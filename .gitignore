# System and Google Drive
desktop.ini
Thumbs.db
.DS_Store
~$*
*.tmp

# Python
__pycache__/
*.pyc

# Media bank: versions structure and catalogs, never the media files
/media/**
!/media/**/
!/media/**/.gitkeep
!/media/README.md
!/media/catalog.csv
!/media/projects.csv
!/media/uses.csv

# Projects: versions sheets and texts; guides and kits (PDF, AI, fonts…) stay only on the Drive
/projects/*/guides/**
/projects/*/kit/**
!/projects/*/guides/**/
!/projects/*/kit/**/
!/projects/**/.gitkeep
!/projects/**/*.md

# Deliveries (final PNGs) are media: they stay out of Git, like the bank
/projects/*/deliveries/**
!/projects/*/deliveries/**/
!/projects/*/deliveries/**/.gitkeep
